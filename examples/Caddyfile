# /etc/caddy/Caddyfile — replace placeholders before use
<YOUR_DOMAIN> {
	# Only the secret path is exposed to Claude (MCP + API via key proxy)
	handle_path /<YOUR_SECRET_PATH>/* {
		reverse_proxy localhost:20129 {
			transport http {
				read_timeout 600s
				write_timeout 600s
			}
		}
	}

	# Dashboard (password protected by OmniRoute itself)
	handle {
		reverse_proxy localhost:20128
	}
}
